# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
#   BACKEND_URL            - where /api is proxied (Compose: http://backend:8000,
#                            Kubernetes: the backend Service's full DNS name)
#   NGINX_LOCAL_RESOLVERS  - filled in from /etc/resolv.conf at start-up
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve the backend at request time instead of at start-up, so nginx starts even if the
    # backend isn't up yet (the TaskBoard reference crashed with "host not found in upstream").
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend_upstream ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Vite fingerprints asset filenames, so they can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
