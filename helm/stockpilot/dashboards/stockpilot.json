{
  "uid": "stockpilot-overview",
  "title": "StockPilot · Service & Inventory",
  "description": "API traffic, latency, errors, autoscaling and inventory health for StockPilot",
  "tags": [
    "stockpilot"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
